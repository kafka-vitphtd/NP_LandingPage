---
import { Image } from 'astro:assets';
import cnc from '../../assets/products/cong-nghe-cao.webp';
import tbyt from '../../assets/products/thiet-bi-y-te.webp';
import tbgd from '../../assets/products/thiet-bi-giao-duc.webp';
import tbdn from '../../assets/products/thiet-bi-day-nghe.webp';
import tbvp from '../../assets/products/thiet-bi-van-phong.webp';
import tbnt from '../../assets/products/thiet-bi-noi-that.webp';
import tban from '../../assets/products/thiet-bi-an-ninh.webp';
import tbvt from '../../assets/products/thiet-bi-vien-thong.webp';
import sldl from '../../assets/products/so-hoa-va-luu-tru-du-lieu.webp';
import nlmt from '../../assets/products/nang-luong-mat-troi.webp';
import hbdd from '../../assets/products/ho-boi-di-dong.webp';

// ✅ FIX 1: Dùng Image object thay vì .src
// Astro's <Image /> component sẽ tự động:
//   - Resize về đúng kích thước hiển thị (không còn 3000-4000px)
//   - Convert sang WebP (nhẹ hơn 25-35%)
//   - Thêm width/height để tránh layout shift
const products = [
  { title: "CÔNG NGHỆ CAO",               image: cnc  },
  { title: "THIẾT BỊ Y TẾ",               image: tbyt },
  { title: "THIẾT BỊ GIÁO DỤC",           image: tbgd },
  { title: "THIẾT BỊ DẠY NGHỀ",           image: tbdn },
  { title: "THIẾT BỊ VĂN PHÒNG",          image: tbvp },
  { title: "THIẾT BỊ NỘI THẤT",           image: tbnt },
  { title: "THIẾT BỊ AN NINH",            image: tban },
  { title: "THIẾT BỊ VIỄN THÔNG",         image: tbvt },
  { title: "SỐ HÓA & LƯU TRỮ DỮ LIỆU",  image: sldl },
  { title: "NĂNG LƯỢNG MẶT TRỜI",         image: nlmt },
  { title: "HỒ BƠI DI ĐỘNG",              image: hbdd },
];
---

<section class="products" id="products">
  <div class="products__header">
    <span class="products__label">PRODUCTS</span>
    <a href="products" class="products__more">VIEW ALL PRODUCTS</a>
  </div>
  <div class="products__slider-wrapper">
    <div class="products__slider" id="productSlider">
      {products.map((item, index) => (
        <div class="product-card">
          <Image
            class="product-card__image"
            src={item.image}
            alt={item.title}
            width={600}
            height={380}
            loading={index === 0 ? 'eager' : 'lazy'}
            decoding={index === 0 ? 'sync' : 'async'}
            format="webp"
          />
          <div class="product-card__overlay"></div>
          <div class="product-card__content">
            <h3 class="product-card__title">{item.title}</h3>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
    .products {
        background: #BCB09F;
        overflow: hidden;
        user-select: none;
        text-align: justify;
    }

    /* Header */
    .products__header {
        padding: 80px 40px 0px;
        margin-bottom: 40px;
        font-family: var(--font-family-display);
        font-weight: var(--font-weight-semibold);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .products__label {
        font-size: 20px;
        color: black;
    }
    .products__more {
        font-size: 20px;
        color: #1a1714;
        text-decoration: none;
        padding-bottom: 4px;
        background-image: linear-gradient(#1a1714, #1a1714);
        background-position: 50% 100%;
        background-repeat: no-repeat;
        background-size: 100% 1.5px;
        transition: background-size 0.4s ease;
    }
    .products__more:hover {
        background-size: 0% 1.5px;
    }

    /* Slider */
    .products__slider-wrapper {
        position: relative;
        width: 100%;
        overflow: hidden;
        margin-bottom: 80px;
    }
    .products__slider {
        display: flex;
        gap: 24px;
        padding: 20px 5vw;
        overflow-x: scroll;
        width: 100%;
        box-sizing: border-box;
        scrollbar-width: none;
        -ms-overflow-style: none;
        cursor: grab;
    }
    .products__slider::-webkit-scrollbar {
        display: none;
    }
    .products__slider:active {
        cursor: grabbing;
    }

    /* Card */
    .product-card {
        flex: 0 0 calc((100% - 10vw - 24px * 2) / 3);
        height: 380px;
        border-radius: 5px;
        overflow: hidden;
        position: relative;
        user-select: none;
        opacity: 0;
        transition:
        opacity 0.6s ease,
        transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
        contain: layout style paint;
    }
    .product-card.is-visible {
        opacity: 1;
        transform: translateY(0);
    }

    /* Image */
    .product-card__image {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1);
    }
    .product-card:hover .product-card__image {
        transform: scale(1.07);
        will-change: transform;
    }
    .product-card__overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(
        to top,
        rgba(0, 0, 0, 0.65) 0%,
        rgba(0, 0, 0, 0.15) 50%,
        transparent 100%
        );
        transition: background 1s ease;
    }
    /* Content */
    .product-card__content {
        position: absolute;
        inset: 0;
        padding: 24px 24px 28px;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        z-index: 1;
    }
    .product-card__title {
        font-family: var(--font-family-body);
        font-size: 20px;
        line-height: 1.3;
        margin: 0;
        color: #fff;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        text-shadow: 0 1px 4px rgba(0, 0, 0, 0.4);
        transform: translateY(10px);
        transition: transform 0.9s ease, letter-spacing 0.7s ease;
    }
    .product-card.is-visible:hover .product-card__title {
        transform: translateY(0);
        letter-spacing: 0.12em;
        transition: transform 0.8s ease, letter-spacing 0.77s ease;
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const slider = document.getElementById('productSlider');
        if (!slider) return;

        let currentIndex = 0;
        let isAnimating = false;
        let isUserInteracting = false;
        let autoScrollTimer: ReturnType<typeof window.setInterval> | undefined;

        const cards = Array.from(slider.querySelectorAll<HTMLElement>('.product-card'));
        const total = cards.length;

        cards.forEach((c, i) => {
            setTimeout(() => c.classList.add('is-visible'), i * 80);
        });

        const ease = (t: number) =>
            t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;

        const smoothScrollTo = (target: number, duration = 600, onDone?: () => void) => {
            const start = slider.scrollLeft;
            const dist  = target - start;
            const t0    = performance.now();

            const step = (now: number) => {
                const p = Math.min((now - t0) / duration, 1);
                slider.scrollLeft = start + dist * ease(p);
                if (p < 1) requestAnimationFrame(step);
                else onDone?.();
            };
            requestAnimationFrame(step);
        };

        const getCenteredScrollLeft = (index: number): number => {
            const card = cards[index];
            if (!card) return 0;
            const pl    = parseFloat(getComputedStyle(slider).paddingLeft);
            const avail = slider.clientWidth - pl * 2;
            return card.offsetLeft - pl - (avail - card.offsetWidth) / 2;
        };

        const getClosestIndex = (): number => {
            let best = 0, minD = Infinity;
            cards.forEach((_, i) => {
                const d = Math.abs(slider.scrollLeft - getCenteredScrollLeft(i));
                if (d < minD) { minD = d; best = i; }
            });
            return best;
        };

        const goTo = (index: number, duration = 900) => {
            if (isAnimating) return;
            isAnimating  = true;
            currentIndex = Math.max(0, Math.min(total - 1, index));
            smoothScrollTo(getCenteredScrollLeft(currentIndex), duration, () => {
                isAnimating = false;
            });
        };
        let direction = 1;

        const startAutoScroll = () => {
            clearInterval(autoScrollTimer);
            autoScrollTimer = window.setInterval(() => {
                if (isUserInteracting || isAnimating) return;
                const next = currentIndex + direction;
                if (next >= total - 1) direction = -1;
                else if (next <= 0)    direction =  1;
                goTo(next);
            }, 2500);
        };

        let isDown      = false;
        let startX      = 0;
        let scrollStart = 0;

        let rafId: number | null = null;

        slider.addEventListener('mousedown', (e: MouseEvent) => {
            isDown      = true;
            startX      = e.pageX;
            scrollStart = slider.scrollLeft;
            clearInterval(autoScrollTimer);
        });
        let latestX = 0;
        slider.addEventListener('mousemove', (e: MouseEvent) => {
            if (!isDown) return;
            e.preventDefault();
            latestX = e.pageX;
            if (rafId !== null) return; // frame trước chưa xử lý xong → bỏ qua
                rafId = requestAnimationFrame(() => {
                    slider.scrollLeft = scrollStart - (latestX - startX) * 1.5;  
                    rafId = null;
                });
        }, { passive: false });

        const endDrag = () => {
            if (!isDown) return;
            isDown = false;
            if (rafId !== null) {
                cancelAnimationFrame(rafId); // huỷ frame đang chờ nếu có
                rafId = null;
            }
            currentIndex = getClosestIndex();
            if (currentIndex >= total - 1) direction = -1;
            else if (currentIndex <= 0)    direction =  1;
            smoothScrollTo(getCenteredScrollLeft(currentIndex), 400);
        };

        slider.addEventListener('mouseup',    endDrag);
        slider.addEventListener('mouseleave', () => {
            endDrag();
            isUserInteracting = false;
            startAutoScroll();
        });
        slider.addEventListener('mouseenter', () => {
            isUserInteracting = true;
            clearInterval(autoScrollTimer);
        });

        let touchStartX      = 0;
        let touchScrollStart = 0;

        slider.addEventListener('touchstart', (e: TouchEvent) => {
            touchStartX      = e.touches[0].clientX;
            touchScrollStart = slider.scrollLeft;
            clearInterval(autoScrollTimer);
        }, { passive: true });

        slider.addEventListener('touchmove', (e: TouchEvent) => {
            slider.scrollLeft = touchScrollStart - (e.touches[0].clientX - touchStartX);
        }, { passive: true });

        slider.addEventListener('touchend', () => {
            currentIndex = getClosestIndex();
            if (currentIndex >= total - 1) direction = -1;  // ← thiếu
            else if (currentIndex <= 0)    direction =  1;  // ← thiếu
            smoothScrollTo(getCenteredScrollLeft(currentIndex), 300, () => {
                startAutoScroll();
            });
        }, { passive: true });

        

        requestAnimationFrame(() => requestAnimationFrame(() => {
            slider.scrollLeft = getCenteredScrollLeft(0);
            startAutoScroll();
            }));
        });
</script>