<section class="trust-bar" aria-label="Thành tựu nổi bật của Nam Phương">
    <div class="grid">
        <div class="item">
            <!-- <div class="icon">
                <i class="fa-regular fa-clock"></i>
            </div> -->
            <div class="number">20
                <span class="suffix">
                    +
                </span>
            </div>
            <div class="label">Năm kinh nghiệm</div>
            <div class="desc">Thành lập và phát triển<br>từ năm 2004</div>
        </div>

        <div class="item">
            <!-- <div class="icon">
                <i class="fa-solid fa-users"></i>        
            </div> -->
            <div class="number">1.000
                <span class="suffix">
                    +
                </span>
            </div>
            <div class="label">Khách hàng tin tưởng</div>
            <div class="desc">Trường học, bệnh viện,<br>doanh nghiệp toàn quốc</div>
        </div>

        <div class="item">
            <!-- <div class="icon">
                <i class="fa-solid fa-globe"></i>
            </div> -->
            <div class="number">9
                <span class="suffix">
                    +
                </span>
            </div>
            <div class="label">Lĩnh vực giải pháp</div>
            <div class="desc">Giáo dục · Y tế ·<br>Công nghệ cao</div>
        </div>

        <div class="item">
            <!-- <div class="icon">
                <i class="fa-solid fa-globe"></i>
            </div> -->
            <div class="number">100
                <span class="suffix">
                    %
                </span>
            </div>
            <div class="label">Sản phẩm chính hãng</div>
            <div class="desc">Đại lý bảo hành &amp; phân phối<br>chính thức từ các thương hiệu</div>
        </div>
    </div>
</section>

<style>
    .trust-bar {
        background: #e8e4de;
        padding: 0px 40px 100px;
        user-select: none;
    }
    .trust-bar::before {
        content: '';
        display: block;
        width: 100%;
        height: 0.75px;
        background: #000000;
        margin-bottom: 60px;
    }
    .grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 0;
        margin: 0 auto;
        justify-items: center; 
    }

    .item {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        padding: 0 40px 0 0;
        gap: 8px;
    
        /* Fade-in ban đầu */
        opacity: 0;
        transform: translateY(16px);
        transition: opacity 0.5s ease, transform 0.5s ease;
    }
    .item:not(:first-child) { padding-left: 40px }
    .item:last-child {
        padding-right: 0;
    }
    .item.is-visible {
        opacity: 1;
        transform: translateY(0);
    }

    .item:nth-child(1) { transition-delay: 0ms; }
    .item:nth-child(2) { transition-delay: 80ms; }
    .item:nth-child(3) { transition-delay: 160ms; }
    .item:nth-child(4) { transition-delay: 240ms; }


    .icon {
        width: 24px;
        height: 24px;
        color: #1a1714;
        margin-bottom: 16px;
        opacity: 0.6;
    }
    .number {
        font-family: var(--font-family-display);
        font-size: clamp(36px, 4vw, 52px);
        font-weight: 700;
        color: #1a1714;
        line-height: 1;
        letter-spacing: -0.02em;
    }

    .suffix {
        font-size: 0.6em;
        font-weight: 400;
        opacity: 0.5;
        letter-spacing: 0;
    }
    .label {
       font-family: var(--font-family-display);
        font-size: 13px;
        font-weight: 600;
        color: #1a1714;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        margin-top: 4px;
    }
    .desc {
        font-family: var(--font-family-body);
        font-size: clamp(13px, 1vw, 15px);
        color: rgba(26, 23, 20, 0.5);
        line-height: 1.6;
        font-weight: 400;
    }
</style>

<script>
    const items = document.querySelectorAll('.item');
    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
        if (entry.isIntersecting) {
            (entry.target as HTMLElement).classList.add('is-visible');
            observer.unobserve(entry.target);
        }
        });
    }, { threshold: 0.2 });
    
    items.forEach(item => observer.observe(item));
</script>
