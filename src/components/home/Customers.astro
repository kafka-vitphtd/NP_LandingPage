---
import TruongHoc from '../../assets/customers/truong_hoc.webp'
import BenhVien from '../../assets/customers/benh_vien.webp'   
import DoanhNghiep from '../../assets/customers/doanh_nghiep.webp'
import VienNghienCuu from '../../assets/customers/vien_nghien_cuu.webp'

const customers = [
    {
        id: 0,
        title: "Trường học & Đại học",
        sub: "Giáo dục",
        desc: "Phòng học STEM, thiết bị dạy nghề, thư viện điện tử, hạ tầng mạng",
        img: TruongHoc,
    },
    {
        id: 1,
        title: "Bệnh viện & Phòng khám",
        sub: "Y tế",
        desc: "Thiết bị y tế, hệ thống an ninh, chuyển đổi số hồ sơ bệnh án",
        img: BenhVien,
    },
    {
        id: 2,
        title: "Doanh nghiệp & Cơ quan",
        sub: "Tổ chức",
        desc: "Phòng họp thông minh, âm thanh hội trường, bảo mật thông tin",
        img: DoanhNghiep,
    },
    {
        id: 3,
        title: "Viện nghiên cứu",
        sub: "Nghiên cứu",
        desc: "Thiết bị thí nghiệm, số hóa dữ liệu, hạ tầng công nghệ cao",
        img: VienNghienCuu,
    },
]
---

<section class="customers" id="customers">

    <div class="header">
        <span class="label">KHÁCH HÀNG</span>
        <a href="customers" class="more">VIEW ALL CUSTOMERS</a>
    </div>

    <div class="panels">
        {customers.map((c) => (
            <div class="panel" data-index={c.id}>

                <!-- Ảnh nền -->
                <img class="panel__img" src={c.img.src} alt={c.title} />

                <!-- Overlay -->
                <div class="panel__overlay"></div>

                <!-- Label giữa — hiện khi chưa hover -->
                <div class="panel__label-center">
                    <span class="panel__sub">{c.sub}</span>
                    <span class="panel__sub-title">{c.title}</span>
                </div>

                <!-- Nội dung — hiện khi hover -->
                <div class="panel__content">
                    <span class="panel__content-sub">{c.sub}</span>
                    <h3 class="panel__title">{c.title}</h3>
                    <p class="panel__desc">{c.desc}</p>
                </div>

            </div>
        ))}
    </div>

</section>

<style>
    .customers {
        background: #BCB09F;
        padding: 80px 40px 120px;
        user-select: none;
    }

    .header {
        font-family: var(--font-family-display);
        font-weight: var(--font-weight-semibold);
        font-size: 20px;
        color: #1a1714;
        margin-bottom: 40px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .more {
        font-size: 20px;
        color: #1a1714;
        text-decoration: none;
        padding-bottom: 4px;
        background-image: linear-gradient(#1a1714, #1a1714);
        background-position: 50% 100%;
        background-repeat: no-repeat;
        background-size: 100% 1.5px;
        transition: background-size 0.4s ease;
    }
    .more:hover {
        background-size: 0% 1.5px;
    }

    /* ── Panels container ── */
    .panels {
        display: flex;
        height: 560px;
        gap: 4px;
        border-radius: 6px;
        overflow: hidden;
    }

    /* ── Panel ── */
    .panel {
        position: relative;
        flex: 1;
        overflow: hidden;
        cursor: default;
        transition: flex 0.6s cubic-bezier(0.4, 0, 0.2, 1);
    }

    /* Khi hover vào panels container: thu hẹp nhẹ */
    .panels:has(.panel:hover) .panel {
        flex: 0.65;
    }

    /* Panel được hover: mở rộng */
    .panels:has(.panel:hover) .panel:hover {
        flex: 2;
    }

    /* ── Ảnh nền ── */
    .panel__img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .panel:hover .panel__img {
        transform: scale(1.04);
    }

    /* ── Overlay ── */
    .panel__overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(
            to top,
            rgba(0, 0, 0, 0.72) 0%,
            rgba(0, 0, 0, 0.2) 50%,
            rgba(0, 0, 0, 0.1) 100%
        );
        transition: background 0.4s ease;
    }

    .panel:hover .panel__overlay {
        background: linear-gradient(
            to top,
            rgba(0, 0, 0, 0.80) 0%,
            rgba(0, 0, 0, 0.35) 60%,
            rgba(0, 0, 0, 0.15) 100%
        );
    }

    /* ── Label giữa (collapsed) ── */
    .panel__label-center {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: flex-end;
        gap: 8px;
        text-align: center;
        padding: 16px;
        transition: opacity 0.3s ease;
    }

    .panels:has(.panel:hover) .panel__label-center {
        opacity: 0;
    }

    .panel__sub {
        font-family: var(--font-family-display);
        font-size: 11px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: rgba(255, 255, 255, 0.6);
    }

    .panel__sub-title {
        font-family: var(--font-family-display);
        font-size: clamp(13px, 1.2vw, 16px);
        font-weight: 400;
        color: rgba(255, 255, 255, 0.9);
        line-height: 1.3;
        letter-spacing: -0.01em;
    }

    /* ── Nội dung (expanded) ── */
    .panel__content {
        position: absolute;
        bottom: 0; left: 0; right: 0;
        padding: 32px 28px;
        opacity: 0;
        transform: translateY(10px);
        transition: opacity 0.35s ease 0.15s, transform 0.35s ease 0.15s;
        pointer-events: none;
    }

    .panel:hover .panel__content {
        opacity: 1;
        transform: translateY(0);
    }

    .panel__content-sub {
        display: block;
        font-family: var(--font-family-display);
        font-size: 11px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: rgba(255, 255, 255, 0.6);
        margin-bottom: 8px;
    }

    .panel__title {
        font-family: var(--font-family-display);
        font-size: clamp(18px, 1.8vw, 26px);
        font-weight: 400;
        color: #ffffff;
        margin: 0 0 12px;
        line-height: 1.2;
        letter-spacing: -0.01em;
    }

    .panel__desc {
        font-family: var(--font-family-body);
        font-size: clamp(12px, 0.9vw, 14px);
        color: rgba(255, 255, 255, 0.65);
        line-height: 1.65;
        margin: 0;
    }

    /* ── Responsive ── */
    @media (max-width: 768px) {
        .customers { padding: 60px 24px 80px; }

        .panels {
            flex-direction: column;
            height: auto;
        }

        .panel {
            height: 120px;
            flex: none;
            transition: height 0.5s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .panels:has(.panel:hover) .panel { height: 100px; }
        .panels:has(.panel:hover) .panel:hover { height: 320px; }

        .panel__label-center {
            justify-content: flex-end;
            padding-bottom: 16px;
        }
    }
</style>