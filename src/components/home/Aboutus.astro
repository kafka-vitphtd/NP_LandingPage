---
import Image from '../../assets/about/image.webp'
import Image1 from '../../assets/about/image1.webp'
import Image2 from '../../assets/about/image2.webp'
---

<section class="aboutus" id="aboutus">
    <div class="header">
        <span class="label">ABOUT US</span>
        <a href="aboutus" class="more">MORE ABOUT US</a>
    </div>

    <div class="hero">
        <p class="tagline">
            Founded in 1999, Nam Phương is a family-led company of engineers and architects,
            working across design and construction. Our strength lies in the collective — a team
            of specialists from different disciplines, aligned by a shared mindset and a
            hands-on approach
        </p>
    </div>
    <div class="body"> 
        <div class="image-wrapper">
            <img src={Image.src} alt="About Us" class=" image">
        </div>   

        <div class="content">
            <h2 class="milestone">25 Years of building with balance</h2>
            
            <div class="cols">
                <div class="col">
                    <p class="col-text">
                        A quarter century of ideas, spaces, and structures. For 25 years, Nam Phương
                        has stood at the intersection of design and construction — shaping homes,
                        workplaces, and environments with intention and care.
                    </p>
                </div>
                <div class="col">
                    <p class="col-text">
                        What began as a family-driven studio in 1999 has grown into a trusted name in
                        architecture and building, defined by collaboration, craft, and the pursuit of
                        balance. We're proud of what we've built — and what's next.
                    </p>
                </div>
            </div>
            <div class="images">
                <div class="col-img-wrapper">
                    <img src={Image1.src} alt="About Us Image" class="col-img" />
                </div>

                <div class="col-img-wrapper">
                    <img src={Image2.src} alt="About Us Image" class="col-img" />
                </div>
            </div>
        </div>
    </div>

</section>

<style>
    .aboutus {
        background: #e8e4de;
        padding: 80px 40px 120px;
        overflow: hidden;
        user-select: none;
        text-align: justify;
    }

    /* Header */
    .header {
        font-family: var(--font-family-display);
        font-weight: var(--font-weight-semibold);

        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 40px;
    }
    .label {
        font-size: 20px;
        color: black;
    }
    .more {
        font-size: 20px;
        color: #1a1714;
        text-decoration: none;

        padding-bottom: 4px;            
        background-image: linear-gradient(#1a1714, #1a1714);
        background-position: 50% 100%; 
        background-repeat: no-repeat;   
        background-size: 100% 1.5px;
        transition: background-size 0.4s ease;
    }
    .more:hover {
        background-size: 0% 1.5px;
    }

    /* Hero */
    .hero {
        max-width: 100%;
        margin: 0 auto;
    }
    .tagline {
        font-family: var(--font-family-body);
        font-size: 30px;
        font-weight: var(--font-weight-regular);
        line-height: 1.35;
        margin: 0;
    }

    .body {
        padding-top: 100px;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0px 150px;
        align-items: start;        
    }

    .image-wrapper {
        height: 650px;
        width: 500px;
        position: relative;
        overflow: hidden;
        border-radius: 5px;
    }

    .content {
        flex: 1;
    }
    .milestone {
        font-size: clamp(22px, 2.2vw, 30px);
        font-weight: 400;
        line-height: 1.28;
        letter-spacing: -0.01em;
        color: #000000;
        margin: 0 0 36px;
    }
    .cols {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 40px;
    }
    .col {
        margin: 0;
    }
    .col {
        font-size: clamp(13px, 1.1vw, 16px);
        line-height: 1.72;
        color: var(--color-muted);
        margin: 0;
    }
    .images {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0px 10px;
        margin-top: 30px;
    }
    .col-img-wrapper {
        width: 300px;
        height: 350px;
        overflow: hidden;
        border-radius: 5px;
    }
    .image,
    .col-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .image,
    .col-img {
        opacity: 0;
        transition: opacity 0.5s ease;
    }

    .image.is-visible,
    .col-img.is-visible {
        opacity: 1;
    }
</style>

<script>
    // const images = document.querySelectorAll('.image, .col-img');
    // const observer = new IntersectionObserver((entries) => {
    //     entries.forEach(entry => {
    //         if (entry.isIntersecting) {
    //             entry.target.classList.add('is-visible');
    //             observer.unobserve(entry.target); // ← cần `const observer` ở trên
    //         }
    //     });
    // }, { threshold: 0.2 });

    // images.forEach(img => observer.observe(img));
    // const parallaxImgs = document.querySelectorAll('.image, .col-img');
    // window.addEventListener('scroll', () => {
    //     parallaxImgs.forEach(img => {
    //         const el = img as HTMLElement;
    //         const rect = el.parentElement!.getBoundingClientRect(); // ← dùng wrapper, không phải img
    //         const offset = (window.innerHeight / 2 - rect.top) * 0.1;
    //         el.style.transform = `translateY(${offset}px)`;
    //     });
    // }, { passive: true });

    // Fade in cho tất cả ảnh
    const images = document.querySelectorAll('.image, .col-img');
    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                (entry.target as HTMLElement).style.opacity = '1';
                observer.unobserve(entry.target);
            }
        });
    }, { threshold: 0.2 });
    images.forEach(img => observer.observe(img));

    // Parallax riêng cho từng ảnh
    const parallaxImgs = document.querySelectorAll('.image, .col-img');
    window.addEventListener('scroll', () => {
        parallaxImgs.forEach(img => {
            const el = img as HTMLElement;
            const rect = el.getBoundingClientRect();
            const scrollY = Math.max(0, -rect.top);
            el.style.transform = `translateY(${scrollY * 0.3}px)`;
        });
    }, { passive: true });
</script>

 